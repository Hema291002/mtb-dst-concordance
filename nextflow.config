// ---------------------------------------------------------------------------
// M. tuberculosis DST concordance pipeline
//
// Per-sample path only: trim, align, mark duplicates, coverage, call, filter.
// Metadata handling, WHO catalogue interpretation and lineage assignment
// remain as scripts in bin/. They are one-off cohort-level analyses, not
// per-sample steps, and forcing them into processes would add complexity
// without adding capability. nf-core pipelines make the same split.
// ---------------------------------------------------------------------------

params {
    // Input
    input       = null                  // samplesheet CSV
    outdir      = "${launchDir}/results_nf"

    // Reference
    fasta       = null                  // H37Rv FASTA, indexed
    mask        = null                  // repeat regions to exclude
    targets     = null                  // resistance gene regions

    // Trimming (fastp)
    min_length  = 50
    cut_mean_q  = 20
    n_base_limit = 5

    // Alignment
    min_mapq    = 20                    // also used at pileup

    // Variant filtering
    min_qual    = 30
    min_dp      = 10
    min_mq      = 40
    min_af      = 0.9
    max_depth   = 500                   // bcftools mpileup cap

    // Resources: defaults suit a laptop. Override with -profile or -c.
    max_cpus    = 4
    max_memory  = '4.GB'
    max_time    = '8.h'
}

// Every filter threshold above is a decision, documented in
// docs/filter_rationale.md. They are parameters rather than literals so the
// sensitivity of the results to each can be tested without editing code.

includeConfig 'conf/base.config'

profiles {

    conda {
        conda.enabled          = true
        docker.enabled         = false
        singularity.enabled    = false
        conda.channels         = ['conda-forge', 'bioconda']
    }

    docker {
        docker.enabled         = true
        conda.enabled          = false
        singularity.enabled    = false
        docker.runOptions      = '-u $(id -u):$(id -g)'
    }

    singularity {
        singularity.enabled    = true
        singularity.autoMounts = true
        conda.enabled          = false
        docker.enabled         = false
    }

    test {
        includeConfig 'conf/test.config'
    }
}

// Reports are written per run, timestamped, so successive runs do not
// overwrite each other's provenance.

timeline { enabled = true; overwrite = true; file = "${params.outdir}/pipeline_info/timeline.html" }
report   { enabled = true; overwrite = true; file = "${params.outdir}/pipeline_info/report.html" }
trace    { enabled = true; overwrite = true; file = "${params.outdir}/pipeline_info/trace.txt" }
dag      { enabled = true; overwrite = true; file = "${params.outdir}/pipeline_info/dag.html" }

manifest {
    name            = 'mtb-dst-concordance'
    author          = 'U. Hema'
    homePage        = 'https://github.com/Hema291002/mtb-dst-concordance'
    description     = 'Genotypic prediction of INH and RIF resistance in M. tuberculosis, compared against laboratory phenotype'
    mainScript      = 'main.nf'
    nextflowVersion = '>=24.10.0'
    version         = '1.0.0'
}
