// ---------------------------------------------------------------------------
// Minimal test profile.
//
// Two isolates, subsampled to 200,000 read pairs each, deliberately chosen to
// be different from one another:
//
//   ERR181948   lineage 4, susceptible to both drugs, 100 bp reads
//   ERR13261328 lineage 2, resistant to both drugs, carries katG S315T and
//               rpoB S450L, 150 bp reads
//
// The pair covers both resistance states, two lineages, and two read lengths,
// so a run that succeeds here has exercised the branches that matter.
//
// Usage:
//   nextflow run main.nf -profile test,conda
// ---------------------------------------------------------------------------

params {
    config_profile_name        = 'Test profile'
    config_profile_description = 'Two subsampled isolates, minimal resources'

    max_cpus   = 2
    max_memory = '2.GB'
    max_time   = '1.h'

    input   = "${projectDir}/test/samplesheet_test.csv"
    fasta   = "${System.getenv('HOME')}/mtb-data/ref/GCF_000195955.2_ASM19595v2_genomic.fna"
    mask    = "${projectDir}/assets/regions/mask.bed"
    targets = "${projectDir}/assets/regions/targets.bed"

    outdir  = "${launchDir}/results_test"
}
