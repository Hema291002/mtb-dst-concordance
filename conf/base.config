// ---------------------------------------------------------------------------
// Per-process resource allocation.
//
// Defaults are sized for a laptop with 4 logical cores and roughly 4 GB of
// usable memory, which is the machine this pipeline was developed on. A
// cluster profile would override these.
//
// Every process retries once on an out-of-memory or timeout exit code, with
// more memory on the retry. Beyond that it fails rather than looping.
// ---------------------------------------------------------------------------

process {

    cpus   = 1
    memory = 1.GB
    time   = 1.h

    errorStrategy = { task.exitStatus in [104,134,137,139,140,143,247] ? 'retry' : 'finish' }
    maxRetries    = 1
    maxErrors     = '-1'

    // Outputs are copied out of the work directory into a readable tree.
    // 'copy' rather than 'symlink' so results survive a work/ cleanup.
    publishDir = [
        path: { "${params.outdir}/${task.process.tokenize(':')[-1].toLowerCase()}" },
        mode: 'copy'
    ]


    // Alignment is the only genuinely CPU-bound step. bwa-mem2 scales well;
    // sorting is given fewer threads so it does not compete with it.
    withName: 'BWAMEM2_ALIGN' {
        cpus   = { Math.min(4, params.max_cpus) }
        memory = { 2.GB * task.attempt }
        time   = { 2.h * task.attempt }
    }

    withName: 'FASTP' {
        cpus   = { Math.min(4, params.max_cpus) }
        memory = { 1.GB * task.attempt }
    }

    // Duplicate marking pipes through four samtools stages. Memory is capped
    // explicitly inside the process because samtools sort can overshoot its
    // -m setting.
    withName: 'SAMTOOLS_MARKDUP' {
        cpus   = 2
        memory = { 2.GB * task.attempt }
        time   = { 1.h * task.attempt }
    }

    withName: 'BCFTOOLS_CALL' {
        cpus   = 1
        memory = { 1.GB * task.attempt }
        time   = { 1.h * task.attempt }
    }

    withName: 'MOSDEPTH' {
        cpus   = 2
        memory = { 1.GB * task.attempt }
    }

    withName: 'BCFTOOLS_FILTER' {
        cpus   = 1
        memory = { 500.MB * task.attempt }
    }
}
